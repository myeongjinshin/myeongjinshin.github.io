<div class="card-text cv-education-list">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    {% if content.startDate and content.startDate != '' %}
      {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
      {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
      {% assign date = startDate | append: ' - ' | append: endDate %}
    {% else %}
      {% assign date = null %}
    {% endif %}
    <article class="cv-education-item">
      <div class="cv-education-meta">
        {% if date %}
          <span class="cv-date-pill">{{ date }}</span>
        {% endif %}
        {% if content.location %}
          <span class="cv-location"><i class="fa-solid fa-location-dot iconlocation"></i> {{ content.location }}</span>
        {% endif %}
      </div>
      <div class="cv-education-body">
        <h4 class="cv-education-degree">
          {% if content.url %}
            <a href="{{ content.url }}">{{ content.studyType }}</a>
          {% else %}
            {{ content.studyType }}
          {% endif %}
        </h4>
        <p class="cv-education-school">{{ content.institution }}</p>
        {% if content.area %}
          <p class="cv-education-area">{{ content.area }}</p>
        {% endif %}
        {% if content.score %}
          <p class="cv-education-score">{{ content.score }}</p>
        {% endif %}
        {% if content.courses %}
          <ul class="items cv-education-notes">
            {% for item in content.courses %}
              <li><span class="item">{{ item }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>
